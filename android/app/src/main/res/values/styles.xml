<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#796747</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F0E6</item>
        <item name="android:navigationBarColor">#F4F0E6</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F4F0E6</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C9BC94</item>
        <item name="android:statusBarColor">#1D1F1B</item>
        <item name="android:navigationBarColor">#1D1F1B</item>
        <item name="android:windowBackground">#1D1F1B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
